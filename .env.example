# Copia este archivo a .env y rellena los valores. .env no se versiona.
#
# La división es la misma que en apphosting.yaml y por la misma razón: lo que
# lleva prefijo VITE_ acaba dentro del paquete que descarga el navegador, y lo
# que no, se queda en el servidor. El token del proveedor autoriza a emitir
# comprobantes bajo el RUC de la empresa: si algún día aparece con prefijo VITE_,
# es una fuga.

# --- Configuración pública del cliente de Firebase ------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_APP_CHECK_CLAVE_SITIO=

# En desarrollo, apuntar el cliente a la Emulator Suite en lugar de a la nube.
VITE_USAR_EMULADORES=true

# --- Servidor -------------------------------------------------------------

ZONA_HORARIA=America/Lima

# Entorno de demostración del proveedor mientras se resuelve T027.
PROVEEDOR_URL_BASE=
PROVEEDOR_TOKEN=

ASISTENCIA_CLAVE_PRIMARIA=
ASISTENCIA_CLAVE_SECUNDARIA=

TAREAS_SECRETO_COMPARTIDO=
