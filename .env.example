# Copia este archivo a .env.local y rellena los valores. .env.local no se versiona.
#
# La división es la misma que en apphosting.yaml y por la misma razón: lo que
# lleva prefijo VITE_ acaba dentro del paquete que descarga el navegador, y lo
# que no, se queda en el servidor. El token del proveedor autoriza a emitir
# comprobantes bajo el RUC de la empresa: si algún día aparece con prefijo VITE_,
# es una fuga.

# --- Configuración pública del cliente de Firebase ------------------------
# Proyecto: blayblocklabs-antrax · Hosting site: suitpay

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=blayblocklabs-antrax.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=blayblocklabs-antrax
VITE_FIREBASE_STORAGE_BUCKET=blayblocklabs-antrax.firebasestorage.app
VITE_FIREBASE_APP_ID=

# Emisión UI operativa: Firebase cloud (false). Emuladores solo para pruebas
# de reglas (T022) cuando haya Java — no son el camino de venta.
VITE_USAR_EMULADORES=false

# --- Servidor -------------------------------------------------------------

ZONA_HORARIA=America/Lima

# Fase de operación: DEMO (omisión) | PRODUCCION
# En DEMO las series reguladas se pueden crear solo en Firestore (sin sync al
# proveedor) para pruebas manuales y presentación. Antes del lanzamiento
# oficial: SUITPAY_FASE=PRODUCCION. Ver docs/FASE-OPERACION.md.
SUITPAY_FASE=DEMO

# Credenciales del Admin SDK en local (ADC). En PowerShell, por ejemplo:
#   gcloud auth application-default login
# o GOOGLE_APPLICATION_CREDENTIALS apuntando a una cuenta de servicio.
#
# OBLIGATORIO que coincida con VITE_FIREBASE_PROJECT_ID. Si gcloud apunta a
# otro proyecto (p. ej. la tienda), verifyIdToken falla y el UI dice
# «sesión caducó» aunque el login esté bien — y las server functions
# (usuarios, emisión, consulta RUC) pueden responder 500.
# En App Hosting también debe existir (apphosting.yaml, RUNTIME).
GOOGLE_CLOUD_PROJECT=blayblocklabs-antrax

# Entorno de demostración del proveedor (T027). Nunca con prefijo VITE_.
# Facturación v3 (emitir/consultar documentos). Distinto del host de RUC/DNI.
PROVEEDOR_URL_BASE=https://api.factpro.la
PROVEEDOR_TOKEN=
# Consulta RUC/DNI (GET /api/v1/ruc|dni/…). Por omisión: https://consultas.factpro.la
# PROVEEDOR_CONSULTAS_URL_BASE=https://consultas.factpro.la
#
# Pruebas / e2e: por omisión el proveedor es el real. Solo pon
# PROVEEDOR_SIMULADO=true si quieres forzar el doble local (p. ej. sin red).
# PROVEEDOR_SIMULADO=false

ASISTENCIA_CLAVE_PRIMARIA=
ASISTENCIA_CLAVE_SECUNDARIA=
# true = doble local (unit/e2e sin Gemini). En prod omitir o false.
# ASISTENCIA_SIMULADA=true
# ASISTENCIA_MODELO=gemini-3-flash-preview
# (No uses VITE_GEMINI_MODEL: las claves/modelo de asistencia son solo de servidor.)
#
# El dictado/foto también usa Cloud Storage (subida cliente + lectura Admin).
# El bucket debe coincidir con VITE_FIREBASE_STORAGE_BUCKET. En local hace falta
# ADC (`gcloud auth application-default login`) para que el servidor lea el
# objeto subido.
