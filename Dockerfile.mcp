# Imagen del servidor MCP (Cloud Run `suitpay-mcp`, us-central1, min 0, max 2).
# Este archivo no despliega. El arranque exige MCP_ALLOWED_HOSTS cuando
# MCP_HOST=0.0.0.0. Credenciales: ADC del runtime, sin llave JSON.
FROM node:22.22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install --omit=dev

COPY src ./src
COPY tsconfig.json ./

ENV NODE_ENV=production
ENV PORT=8080
ENV MCP_HOST=0.0.0.0

USER node
EXPOSE 8080

CMD ["node", "--experimental-strip-types", "src/mcp/servidor.ts"]
