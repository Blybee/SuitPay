rules_version = '2';

// Acceso a los medios originales de las capturas.
//
// Cada vendedor escribe solo bajo su propio prefijo y no lee los medios de
// otros. Los originales de audio e imagen contienen la voz del vendedor y,
// potencialmente, nombres de clientes escritos en papel.
//
// La eliminación está permitida por optimización: acumular audios pequeños
// todos los días —que no tienen uso más allá del día civil en Lima— consumiría
// más recursos de los necesarios. La UI no ofrece borrar; el lifecycle nativo
// del bucket caduca audios a 1 día y fotografías a 1 semana
// (storage.lifecycle.json). El vendedor puede borrar los propios para
// operaciones de mantenimiento; no puede tocar los de otro.

service firebase.storage {
  match /b/{bucket}/o {

    function activo() {
      return request.auth != null && request.auth.token.activo == true;
    }

    match /capturas/{vendedorId}/{archivo} {
      allow read: if activo() && request.auth.uid == vendedorId;

      allow write: if activo()
                   && request.auth.uid == vendedorId
                   && request.resource.size < 12 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('audio/.*'));

      allow delete: if activo() && request.auth.uid == vendedorId;
    }

    match /{rutaCualquiera=**} {
      allow read, write: if false;
    }
  }
}
