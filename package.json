{
  "name": "suitpay",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && node scripts/postbuild-hosting.mjs",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "generar-rutas": "tsr generate",
    "tipos": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "formato:comprobar": "prettier --check .",
    "prueba": "vitest run --project dominio --project servidor --project interfaz",
    "prueba:ver": "vitest --project dominio --project servidor --project interfaz",
    "prueba:cobertura": "vitest run --coverage --project dominio --project servidor",
    "prueba:proveedor": "vitest run --project servidor tests/unit/server/contribuyente-demo.test.ts tests/unit/server/establecimientos-demo.test.ts tests/unit/server/establecimientos-simulado.test.ts",
    "emuladores": "firebase emulators:start --project demo-suitpay --only firestore,auth,storage",
    "prueba:emulador": "firebase emulators:exec --project demo-suitpay --only firestore,auth,storage \"vitest run --project emulador\"",
    "prueba:e2e": "playwright test",
    "prueba:e2e:completa": "firebase emulators:exec --project demo-suitpay --only firestore,auth,storage \"playwright test\"",
    "frontera": "node scripts/verificar-frontera.mjs",
    "humo:produccion": "node scripts/humo-produccion.mjs",
    "verificar": "npm run tipos && npm run lint && npm run prueba",
    "verificar:todo": "npm run verificar && npm run build && npm run frontera && npm run humo:produccion"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/nitro-v2-vite-plugin": "^1.155.0",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-start": "^1.168.32",
    "@tanstack/react-virtual": "^3.14.10",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "fuse.js": "^7.5.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.27.0",
    "nitro": "^3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sileo": "^0.1.5",
    "tailwindcss": "^4.1.18",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.0",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.20.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "firebase-tools": "^15.24.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
