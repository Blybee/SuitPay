Thumbs.db
desktop.ini
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
