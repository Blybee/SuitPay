# Secrets / environment
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
serviceAccount*.json

# Dependencias y salidas de construcción
#
# `node_modules/` NO se versiona. Lo que sí se versiona es `package-lock.json`:
# en su interior aparecen claves con el prefijo "node_modules/...", y eso es
# normal. Sirve para que `npm ci` instale las mismas versiones en otro equipo
# o en CI. Si en la UI de commit ves miles de rutas "node_modules/@…", estás
# mirando el diff de package-lock.json, no la carpeta instalada.
node_modules/
dist/
dist-ssr/
.output/
.nitro/
.tanstack/
.vinxi/
.wrangler/
.vite/
*.local
*.tsbuildinfo
__unconfig*

# Estado local de herramientas (no es código del producto)
.impeccable/

# Pruebas
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# Emuladores de Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log
pubsub-debug.log
firebase-export-*/

# Spec Kit: catalogs are re-downloadable caches
.specify/extensions/.cache/
.specify/presets/.cache/
.specify/bundles/.cache/

# Coding agent local state (may contain auth tokens)
.cursor/mcp.json
.cursor/*.local.json

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
